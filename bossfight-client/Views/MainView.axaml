<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:bossfight_client.ViewModels"
             xmlns:responses="using:bossfight_client.Responses"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="340"
             x:Class="bossfight_client.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Stored in store.json next to the executable."
                 Opacity="0.6" TextWrapping="Wrap" />

      <TextBlock Text="API Key" FontWeight="SemiBold" />
      <TextBox Text="{Binding ApiKey}" Watermark="Paste your API key" />
      <TextBlock Text="{Binding ApiKeyError}"
                 Foreground="#D13438"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ApiKeyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <TextBlock Text="Player ID" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox ItemsSource="{Binding AvailablePlayers}"
                  SelectedItem="{Binding SelectedPlayer}"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select a player"
                  Grid.Column="0">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="responses:Player">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Refresh"
                Command="{Binding RefreshPlayersCommand}"
                Margin="8,0,0,0"
                Grid.Column="1" />
      </Grid>

      <TextBlock Text="API URL" FontWeight="SemiBold" />
      <TextBox Text="{Binding ApiUrl}" Watermark="https://example.com/api" />
      <TextBlock Text="{Binding ApiUrlError}"
                 Foreground="#D13438"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ApiUrlError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <ProgressBar IsIndeterminate="True" Height="3"
                   IsVisible="{Binding IsBusy}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Save" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.75" />
      </StackPanel>

      <TextBlock Text="Closing the window hides it to the tray. Use the tray menu to reopen or quit."
                 Opacity="0.5" TextWrapping="Wrap" FontSize="12" />

    </StackPanel>
  </ScrollViewer>
</UserControl>